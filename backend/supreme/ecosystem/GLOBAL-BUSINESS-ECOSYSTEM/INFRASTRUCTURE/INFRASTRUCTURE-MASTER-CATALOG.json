{
  "catalog": {
    "id": "global-infrastructure-master-catalog",
    "name": "Global Infrastructure Master Catalog",
    "version": "1.0.0",
    "status": "active-development",
    "scope": "global"
  },

  "definition": {
    "purpose": "Structured master catalog of the physical, virtual and digital infrastructure required to operate computing, networking, storage, software, cloud and internet systems.",
    "coverage": "A-Z",
    "layers": [
      "physical-infrastructure",
      "compute-infrastructure",
      "network-infrastructure",
      "storage-infrastructure",
      "data-center-infrastructure",
      "virtualization-infrastructure",
      "container-infrastructure",
      "internet-infrastructure",
      "power-infrastructure",
      "cooling-infrastructure",
      "monitoring-infrastructure",
      "security-infrastructure",
      "management-infrastructure"
    ]
  },

  "categories": [
    {
      "id": "physical-infrastructure",
      "name": "Physical Infrastructure",
      "includes": [
        "servers",
        "racks",
        "cabinets",
        "network-equipment",
        "storage-equipment",
        "computing-hardware",
        "cables",
        "fiber-optics",
        "connectors",
        "peripherals"
      ]
    },
    {
      "id": "compute-infrastructure",
      "name": "Compute Infrastructure",
      "includes": [
        "CPUs",
        "GPUs",
        "TPUs",
        "accelerators",
        "memory",
        "compute-nodes",
        "bare-metal-computing",
        "high-performance-computing",
        "edge-computing"
      ]
    },
    {
      "id": "network-infrastructure",
      "name": "Network Infrastructure",
      "includes": [
        "routers",
        "switches",
        "firewalls",
        "load-balancers",
        "gateways",
        "network-interfaces",
        "wireless-networks",
        "wired-networks",
        "fiber-networks",
        "network-management"
      ]
    },
    {
      "id": "storage-infrastructure",
      "name": "Storage Infrastructure",
      "includes": [
        "hard-disk-drives",
        "solid-state-drives",
        "network-attached-storage",
        "storage-area-networks",
        "object-storage",
        "block-storage",
        "file-storage",
        "backup-storage",
        "archival-storage"
      ]
    },
    {
      "id": "data-center-infrastructure",
      "name": "Data Center Infrastructure",
      "includes": [
        "data-centers",
        "server-rooms",
        "racks",
        "power-distribution",
        "cooling",
        "physical-security",
        "environmental-monitoring",
        "network-connectivity",
        "data-center-management"
      ]
    },
    {
      "id": "virtualization-infrastructure",
      "name": "Virtualization Infrastructure",
      "includes": [
        "virtual-machines",
        "hypervisors",
        "virtual-networks",
        "virtual-storage",
        "virtual-compute",
        "virtual-machine-management"
      ]
    },
    {
      "id": "container-infrastructure",
      "name": "Container Infrastructure",
      "includes": [
        "containers",
        "container-runtimes",
        "container-images",
        "container-registries",
        "container-orchestration",
        "container-networks",
        "container-storage"
      ]
    },
    {
      "id": "internet-infrastructure",
      "name": "Internet Infrastructure",
      "includes": [
        "internet-service-providers",
        "internet-exchange-points",
        "backbone-networks",
        "routing",
        "DNS-infrastructure",
        "content-delivery-networks",
        "transit-networks",
        "peering"
      ]
    },
    {
      "id": "power-infrastructure",
      "name": "Power Infrastructure",
      "includes": [
        "electrical-power",
        "UPS",
        "power-distribution",
        "backup-generators",
        "batteries",
        "power-monitoring"
      ]
    },
    {
      "id": "cooling-infrastructure",
      "name": "Cooling Infrastructure",
      "includes": [
        "air-cooling",
        "liquid-cooling",
        "HVAC",
        "thermal-management",
        "environmental-control"
      ]
    },
    {
      "id": "monitoring-infrastructure",
      "name": "Monitoring Infrastructure",
      "includes": [
        "infrastructure-monitoring",
        "network-monitoring",
        "server-monitoring",
        "resource-monitoring",
        "log-collection",
        "metrics",
        "alerts",
        "observability"
      ]
    },
    {
      "id": "security-infrastructure",
      "name": "Security Infrastructure",
      "includes": [
        "network-security",
        "physical-security",
        "identity-security",
        "access-control",
        "encryption-infrastructure",
        "security-monitoring",
        "security-management"
      ]
    },
    {
      "id": "management-infrastructure",
      "name": "Infrastructure Management",
      "includes": [
        "asset-management",
        "configuration-management",
        "capacity-management",
        "performance-management",
        "availability-management",
        "maintenance",
        "automation",
        "infrastructure-as-code"
      ]
    }
  ],

  "relationships": [
    {
      "from": "physical-infrastructure",
      "to": "compute-infrastructure",
      "relationship": "provides"
    },
    {
      "from": "compute-infrastructure",
      "to": "software-systems",
      "relationship": "runs"
    },
    {
      "from": "network-infrastructure",
      "to": "internet-infrastructure",
      "relationship": "connects"
    },
    {
      "from": "storage-infrastructure",
      "to": "data-systems",
      "relationship": "stores"
    },
    {
      "from": "virtualization-infrastructure",
      "to": "virtual-systems",
      "relationship": "provides"
    },
    {
      "from": "container-infrastructure",
      "to": "applications",
      "relationship": "runs"
    },
    {
      "from": "monitoring-infrastructure",
      "to": "all-infrastructure",
      "relationship": "monitors"
    },
    {
      "from": "security-infrastructure",
      "to": "all-infrastructure",
      "relationship": "protects"
    }
  ]
}
